{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fahad9101/Biotech-swing-filter-engine-/contracts/candidate-output.schema.json",
  "title": "BOE-1.0.0 Candidate Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "identity", "catalyst", "score", "decision", "probability", "financials", "valuation", "technicals", "risks", "thesis", "provenance"],
  "$defs": {
    "money": {"type": "object", "additionalProperties": false, "required": ["value", "currency"], "properties": {"value": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}, "currency": {"const": "USD"}}},
    "range": {"type": "object", "additionalProperties": false, "required": ["low", "mid", "high"], "properties": {"low": {"type": "number"}, "mid": {"type": "number"}, "high": {"type": "number"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "url", "available_at", "retrieved_at", "tier"], "properties": {"id": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "available_at": {"type": "string", "format": "date-time"}, "retrieved_at": {"type": "string", "format": "date-time"}, "tier": {"type": "integer", "minimum": 1, "maximum": 8}, "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}}}
  },
  "properties": {
    "meta": {"type": "object", "additionalProperties": false, "required": ["analysis_run_id", "generated_at", "as_of", "evidence_cutoff", "rules_version", "rules_checksum", "code_commit_sha", "data_coverage_pct"], "properties": {"analysis_run_id": {"type": "string", "format": "uuid"}, "generated_at": {"type": "string", "format": "date-time"}, "as_of": {"type": "string", "format": "date-time"}, "evidence_cutoff": {"type": "string", "format": "date-time"}, "rules_version": {"const": "BOE-1.0.0"}, "rules_checksum": {"type": "string"}, "code_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "data_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["ticker", "company", "cik", "exchange", "security_type", "universe_eligible"], "properties": {"ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"}, "company": {"type": "string"}, "cik": {"type": "string", "pattern": "^[0-9]{10}$"}, "exchange": {"enum": ["NASDAQ", "NYSE", "NYSE_AMERICAN"]}, "security_type": {"enum": ["COMMON_STOCK", "ADR"]}, "universe_eligible": {"type": "boolean"}, "market_cap": {"$ref": "#/$defs/money"}, "enterprise_value": {"$ref": "#/$defs/money"}}},
    "catalyst": {"type": "object", "additionalProperties": false, "required": ["type", "lead_asset", "indication", "clinical_phase", "title", "window_start", "window_end", "timing_confidence", "primary_source_id"], "properties": {"type": {"enum": ["CLIN_P1", "CLIN_P1_2", "CLIN_P2", "CLIN_P2_3", "CLIN_P3", "REG_SUBMIT", "REG_ADCOM", "REG_DECISION", "REG_OTHER", "CONF_DATA", "PUBLICATION", "PARTNER", "COMMERCIAL", "FINANCING"]}, "lead_asset": {"type": "string"}, "indication": {"type": "string"}, "clinical_phase": {"type": "string"}, "title": {"type": "string"}, "window_start": {"type": "string", "format": "date"}, "window_end": {"type": "string", "format": "date"}, "timing_confidence": {"enum": ["UNVERIFIED", "LOW", "MODERATE", "HIGH"]}, "primary_source_id": {"type": "string"}}},
    "score": {"type": "object", "additionalProperties": false, "required": ["raw_total", "factors"], "properties": {"raw_total": {"type": "integer", "minimum": 0, "maximum": 100}, "factors": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["code", "points", "max_points", "subfactors"], "properties": {"code": {"enum": ["CATALYST", "SCIENCE", "MARKET_IMPACT", "CASH_DILUTION", "VALUATION", "TECHNICAL", "OWNERSHIP", "SENTIMENT"]}, "points": {"type": "integer", "minimum": 0}, "max_points": {"type": "integer", "minimum": 1}, "subfactors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "points", "max_points", "data_state", "rationale", "evidence_ids"], "properties": {"code": {"type": "string"}, "points": {"type": "integer", "minimum": 0}, "max_points": {"type": "integer", "minimum": 1}, "data_state": {"enum": ["OBSERVED", "DERIVED", "ESTIMATED", "MISSING"]}, "rationale": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}}}}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["classification", "final_decision", "triggered_gates", "preferred_entry_zone", "do_not_chase_price", "bull_target", "base_target", "failure_value"], "properties": {"classification": {"enum": ["HIGH_CONVICTION_CATALYST_SWING", "CATALYST_SWING", "WATCHLIST", "TOO_EARLY", "OVEREXTENDED_DO_NOT_CHASE", "FINANCING_RISK", "BINARY_RISK_UNFAVORABLE_ASYMMETRY", "REJECT"]}, "final_decision": {"type": "string"}, "triggered_gates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "reason", "precedence"], "properties": {"code": {"type": "string"}, "reason": {"type": "string"}, "precedence": {"type": "integer", "minimum": 1}}}}, "preferred_entry_zone": {"type": ["object", "null"], "additionalProperties": false, "required": ["low", "high"], "properties": {"low": {"$ref": "#/$defs/money"}, "high": {"$ref": "#/$defs/money"}}}, "do_not_chase_price": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "bull_target": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "base_target": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "failure_value": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}}},
    "probability": {"type": "object", "additionalProperties": false, "required": ["event_success_pct", "confidence", "prior_pct", "adjustments"], "properties": {"event_success_pct": {"$ref": "#/$defs/range"}, "confidence": {"enum": ["LOW", "MODERATE", "HIGH"]}, "prior_pct": {"type": "number", "minimum": 0, "maximum": 100}, "adjustments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "percentage_points", "rationale"], "properties": {"code": {"type": "string"}, "percentage_points": {"type": "number"}, "rationale": {"type": "string"}}}}}},
    "financials": {"type": "object", "additionalProperties": false, "required": ["cash", "short_term_investments", "debt", "normalized_quarterly_burn", "runway_months", "runway_at_catalyst_months", "dilution_risk", "fully_diluted_shares"], "properties": {"cash": {"$ref": "#/$defs/money"}, "short_term_investments": {"$ref": "#/$defs/money"}, "debt": {"$ref": "#/$defs/money"}, "normalized_quarterly_burn": {"$ref": "#/$defs/money"}, "runway_months": {"type": "number"}, "runway_at_catalyst_months": {"type": "number"}, "dilution_risk": {"enum": ["LOW", "MODERATE", "HIGH", "IMMINENT"]}, "fully_diluted_shares": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}}},
    "valuation": {"type": "object", "additionalProperties": false, "required": ["conservative_rnpv", "base_rnpv", "bull_rnpv", "margin_of_safety_pct", "success_return_pct", "failure_return_pct", "base_expected_return_pct", "conservative_expected_return_pct", "reward_risk"], "properties": {"conservative_rnpv": {"$ref": "#/$defs/money"}, "base_rnpv": {"$ref": "#/$defs/money"}, "bull_rnpv": {"$ref": "#/$defs/money"}, "margin_of_safety_pct": {"$ref": "#/$defs/range"}, "success_return_pct": {"$ref": "#/$defs/range"}, "failure_return_pct": {"$ref": "#/$defs/range"}, "base_expected_return_pct": {"type": "number"}, "conservative_expected_return_pct": {"type": "number"}, "reward_risk": {"type": "number", "minimum": 0, "maximum": 10}}},
    "technicals": {"type": "object", "additionalProperties": false, "required": ["price", "support", "resistance", "sma20", "sma50", "rsi14", "atr14", "xbi_relative_return_20d_pct", "setup_summary"], "properties": {"price": {"$ref": "#/$defs/money"}, "support": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "resistance": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "sma20": {"$ref": "#/$defs/money"}, "sma50": {"$ref": "#/$defs/money"}, "rsi14": {"type": "number", "minimum": 0, "maximum": 100}, "atr14": {"$ref": "#/$defs/money"}, "xbi_relative_return_20d_pct": {"type": "number"}, "setup_summary": {"type": "string"}}},
    "risks": {"type": "object", "additionalProperties": false, "required": ["scientific", "financial", "regulatory", "technical"], "properties": {"scientific": {"type": "array", "items": {"type": "string"}}, "financial": {"type": "array", "items": {"type": "string"}}, "regulatory": {"type": "array", "items": {"type": "string"}}, "technical": {"type": "array", "items": {"type": "string"}}}},
    "thesis": {"type": "object", "additionalProperties": false, "required": ["summary", "must_happen", "breakers", "next_refresh"], "properties": {"summary": {"type": "string"}, "must_happen": {"type": "array", "items": {"type": "string"}}, "breakers": {"type": "array", "items": {"type": "string"}}, "next_refresh": {"type": "string", "format": "date-time"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["sources", "conflicts", "input_manifest_sha256"], "properties": {"sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}, "conflicts": {"type": "array", "items": {"type": "string"}}, "input_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  }
}
